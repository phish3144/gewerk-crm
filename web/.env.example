# Verbindungsdaten. Die echten Werte gehoeren in .env.local, nicht ins Repo.
#
# Beide Werte sind oeffentlich und fuer den Browser bestimmt: der publishable
# key ist genau dafuer gedacht. Die Mandantentrennung haengt NICHT an ihrer
# Geheimhaltung, sondern daran, dass jeder Zugriff als Rolle `authenticated`
# durch RLS laeuft.
#
# Der service_role-Schluessel wird NIE ausgeliefert und ist im Anwendungscode
# nicht vorgesehen. scripts/kein-dienstschluessel.mjs prueft das nach dem Build.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
